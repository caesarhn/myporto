---
import Header from '../components/MainHeader.astro'
import Preview from '../components/ContentPreview.astro'
import Footer from '../components/MainFooter.astro'
import Search from '../components/search.astro'
import CategoryList from '../components/list/category-list.astro'

const allPosts = Object.values(import.meta.glob('./content/caesar-nuari/*.md', { eager: true }))
const posts = allPosts.map(data => { return data.frontmatter})

export const prerender = false

const params = Astro.url.searchParams
const categorys = ["All", "Technology", "Health", "Economy"]
const categoryRequested = params.get("category")
// categoryRequested = "All"
const domainRecomended = ["Artificial Intelligence", "Otomotif", "Robotics", "Entertaiment", "Arcitecture", "Art"]

var datas = []

var indexads = 0
var data = []
data = posts.map(res => {
    return categoryRequested === "All" ? false : res
})

// console.log(data)
// console.log(categoryRequested)

var currentindex = 0
---

<!doctype html>
<html lang="id" class="">
    <head>
        <meta name="google-adsense-account" content="ca-pub-8502078264600273">
        <link rel="icon" type="image/x-icon" href="/fav.ico">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="EngineeringSampel.com - Platform berbagi cerita & artikel inspiratif seputar teknologi, kesehatan, bisnis, dan lainnya. Baca pengalaman nyata atau tulis kisahmu sekarang!"/>
        <meta charset="UTF-8"/>
        <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8502078264600273" crossorigin="anonymous"></script>
        <title>beranda</title>
    </head>
    <body class="bg-gray-50 dark:bg-gray-900 min-h-full">
        <script>
            import { Modal } from 'flowbite'
            const params = window.location.search
            if(params !== "All" || params !== null){
                
            }
        </script>
        <Header>
            <Search/>
        </Header>
        <main class="flex justify-between mb-0 sm:px-3 lg:mx-auto w-full sm:w-full md:w-1/2 lg:w-2/3 xl:w-4/5">
            <div class="h-fit sm:w-full lg:w-2/3 xl:w-1/2" id="left">
                <div class="sm:mt-12 lg:mt-2">
                    <CategoryList categorys={categorys} categoryRequested="All"/>
                </div>
                {data.length !== 0 ? data.map(res => {
                if(currentindex == indexads){
                    currentindex++
                    return <div class="sm:w-full md:w-11/12 lg:w-3/4 flex justify-center">
                        <ins class="adsbygoogle"
                        style="display:block"
                        data-ad-format="fluid"
                        data-ad-layout-key="-fi-4h+8g-eu+jn"
                        data-ad-client="ca-pub-8502078264600273"
                        data-ad-slot="5250026516"></ins>
                        <script is:inline>
                            (adsbygoogle = window.adsbygoogle || []).push({});
                        </script>      
                    </div>
                    <br/>
                    <div class="sm:w-full md:w-11/12 lg:w-3/4" onclick={"window.location.href='"+res.link+"'"}>
                        <Preview 
                            buttonDeck="butt-deck"
                            creator_name={res.creator} 
                            creator_img={res.profile_img} 
                            tittle={res.title} 
                            content_img={res.preview_image}
                            posted={res.date}
                            like={res.creator}
                            view={res.creator}
                            prev_desc={res.description}
                            img_alt={`image for content ${res.title}`}
                            />
                    </div>
                }else{
                    currentindex++
                    return <div class="sm:w-full md:w-11/12 lg:w-3/4" onclick={"window.location.href='"+res.link+"'"}>
                        <Preview 
                            buttonDeck="butt-deck"
                            creator_name={res.creator} 
                            creator_img={res.profile_img} 
                            tittle={res.title} 
                            content_img={res.preview_image}
                            posted={res.date}
                            like={res.creator}
                            view={res.creator}
                            prev_desc={res.description}
                            img_alt={`image for content ${res.title}`}
                        />
                    </div>
                }}) : () => {
                    return <div class="min-h-screen preview-container">
                        <div class="text-center">no items found</div>
                    </div>
                }}
                </br>
                </br>
            </div>
            <div id="right" class="lg:w-1/3 xl:1/2 border-l-2 border-slate-200 sm:hidden lg:block px-6 pt-6">
                <div class="">
                    <h2 class="text-lg font-bold">Judul macam apa ini</h2>
                </div>
                <div class="mt-8">
                    <h2 class="text-lg font-bold">Domain yang mungkin anda cari</h2>
                    <div class="flex flex-wrap gap-3 text-sm text-slate-700 mb-4 pt-4">
                        {domainRecomended.map(res => {
                            return <div class="rounded-lg bg-gray-200 px-2 py-1">{res}</div>
                        })}
                    </div>
                </div>
                <div class="w-full h-80">
                    <ins class="adsbygoogle"
                        style="display:block; text-align:center;"
                        data-ad-layout="in-article"
                        data-ad-format="fluid"
                        data-ad-client="ca-pub-8502078264600273"
                        data-ad-slot="9794377389"></ins>
                    <script is:inline>
                        (adsbygoogle = window.adsbygoogle || []).push({});
                    </script>
                </div>
            </div>
        </main>
        <script>
            const right = document.getElementById("right");
        
            window.addEventListener('scroll', () => {
                const pos = right.getBoundingClientRect()

                if(pos.bottom > 0 && pos.top < 0){
                }

            });
        </script>
    <Footer/>
    </body>
</html>

<style is:global>
    body{
        position: relative;
        margin: 0px;
        z-index: -1000;
        min-height: 100%;
    }
    .content{
        position: relative;
        top: 10px;
        z-index: -100;
    }
    .content-left{
        left: 0px;
    }
    .head-height{
        height: 70px;
    }
    .preview-container{
        position: relative;
        z-index: -1001;
        width: 50%;
    }
    .preview-container:hover{
        opacity: 70%;
    }

    @media (pointer: coarse)  {
	/* mobile device */
        .logo{
            display: none;
        }
        .content{
            width: 90%;
            min-height: 2000px;
            left: 5%;
            top: 120px;
        }
        .content-left{
            left: 5%;
            font-size: 3vw;
        }
        .head-height{
            height: 120px;

        }
        .preview-container{
            width: 95%;
        }
        #cat{
            position: relative;
            top: 30px;
        }
        .title{
            font-size: 8vw !important;
        }
        .search{
            left: 55% !important;
        }
        .butt-deck .icon p{
            width: 100px;
            top: -22px !important;
            font-size: x-large !important;
            opacity: 60%;
            left: -70px !important;
        }
        .butt-deck img{
            top: 60px;
            height: 40px;
        }
        .footer{
            height: 500px !important;
            top: 120px !important;
        }
    }

    @media (pointer: fine), (pointer: none) {
	/* desktop */
        .content{
            width: 1000px;
            left: calc((100% - 1000px)/2);
        }
        .content-left{
            left: calc((100% - 1000px)/2);
        }
        .search{
            left: calc(((100% - 1000px)/2) + 25%) !important;
        }
        .head-height{
            height: 70px;
        }
        .preview-container{
        }
        #cat{
            position: relative;
            top: 20px;
        }
        .title{
            font-size: 3em !important;
        }

        .butt-deck img{
            top: 20px;
            height: 20px;
        }
        .butt-deck p{
            width: 100px !important;
        }
        .preview-container:hover{
            opacity: 70%;
        }
        @media only screen and (max-width: 1000px) {
            .content{
                left: 10%;
            }
            .preview-container{
                width: 80%;
            }
            .logo{
                width: 200px;
            }
            .content-left{
                left: 300px;
            }
            .search{
                left: 600px !important;
            }
        }
    }
</style>