                            />
                    </div>
                }else{
                    currentindex++
                    return <div class="sm:w-full md:w-11/12 lg:w-3/4" onclick={"window.location.href="+"'/creator/read/"+res.content_root.id+"'"}>
                        <Preview 
                            buttonDeck="butt-deck"
                            creator_name={res.creator.name} 
                            creator_img={res.creator.image} 
                            tittle={res.content_root.tittle} 
                            content_img={res.content_root.previewImg}
                            posted={res.content_root.posted}
                            like={res.content_root.like}
                            view={res.content_root.view}
                            prev_desc={res.content_root.previewDesc}
                            img_alt={`image for content ${res.content_root.tittle}`}
                        />
                    </div>
                }}) : () => {
                    return <div class="min-h-screen preview-container">
                        <div class="text-center">no items found</div>
                    </div>
                }}
                </br>
                </br>
            </div>
