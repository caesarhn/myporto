---
import Header from '../components/MainHeader.astro'
import Preview from '../components/ContentPreview.astro'
import Footer from '../components/MainFooter.astro'
import Search from '../components/search.astro'

import {db} from '../utils/mysql/index'
import {creator, content} from '../models/mysql/schema'
import {eq, and} from 'drizzle-orm'

export const prerender = false

const params = Astro.url.searchParams
const category = ["All", "Technology", "Health", "Economy"]
const categoryRequested = params.get("category")
const domainRecomended = ["Artificial Intelligence", "Otomotif", "Robotics", "Entertaiment", "Arcitecture", "Art"]

const search = Astro.cookies.get("search")?.value === undefined ? "all" : Astro.cookies.get("search")?.value
const searching = Astro.cookies.get("searching")?.value === undefined ? "disable" : Astro.cookies.get("searching")?.value

var datas = []
if(categoryRequested === null || categoryRequested === "All"){
    datas = await db.select({
        creator: creator,
        content_root: {
            id: content.id,
            tittle: content.tittle,
            previewImg: content.previewImg,
            previewDesc: content.previewDesc,
            posted: content.posted,
            like: content.like,
            view: content.view,
        }
    }).from(creator).leftJoin(content, eq(creator.id, content.creatorId))
}else{
    datas = await db.select({
        creator: creator,
        content_root: {
            id: content.id,
            tittle: content.tittle,
            previewImg: content.previewImg,
            previewDesc: content.previewDesc,
            posted: content.posted,
            like: content.like,
            view: content.view,
        }
    }).from(creator).leftJoin(content, and(eq(creator.id, content.creatorId), eq(content.category, categoryRequested)))
}

var indexads = 0
var data = []

if(datas.length !== 0 && datas[0].content_root !== null){
    if(searching === "enable"){
        const dataFilter = datas?.filter(res => {
            return res.content_root.tittle.includes(search)
        })
        data = dataFilter
    }else{
        data = datas
    }
    //data = searching === "enable" ? dataFilter : datas
    Astro.cookies.set("searching", "disable")
    indexads = Math.floor(Math.random() * (data.length - 1)) + 1
}
var currentindex = 0
---

