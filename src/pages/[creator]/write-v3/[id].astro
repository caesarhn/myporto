---
import { eq } from "drizzle-orm"
import Header from "../../../components/MainHeader.astro"
import Input from "../../../components/vue/write-v2.vue"
import { content } from "../../../models/mysql/schema"
import { db } from "../../../utils/mysql"
import { Value } from "sass"

const {creator, id} = Astro.params
const contents = await db.select().from(content).where(eq(content.id, id))
//console.log(contents, id)
const con = contents[0].content

const option = [
    {value: "Technology", label: "Technology"},
    {value: "Health", label: "Health"},
    {value: "Economy", label: "Economy"}
]
---

<!doctype html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" type="image/x-icon" href="/fav.ico">
        <title>write</title>
    </head>
    <body>
        <div id="saving" class="fixed w-fit text-green-400 left-1/2 top-5 hidden">Saving..</div>
        <p id="content_id" class="hidden">{contents[0].id}</p>
        <Header/>
        <div class="sm:w-11/12 md:w-2/3 lg:w-1/2 mx-auto mt-10 mb-7">
            <div class="flex my-7 gap-9 items-center">
                <label class="h-fit text-xl font-semibold">Category :</label>
                <select id="category" class="rounded-lg">
                    <option disabled selected value="">Pilih Kategori..</option>
                    {option.map(opt => {
                        return <option value={opt.value} label={opt.label} selected={contents[0].category === opt.value}></option>
                    })}
                </select>
            </div>
            <textarea id="title" class="w-full focus:outline-none focus:ring-0 border-none resize-none text-4xl font-bold overflow-hidden p-0" placeholder="Title.." spellcheck="false">{contents[0].tittle}</textarea>
            <div class="mt-4 flex gap-5">
                <label>Meta Deskripsi :</label>
                <input id="description" class="outline-none w-full" value={contents[0].previewDesc}/>
            </div>
        </div>
        <div id="input" 
            spellcheck="false"
            class="focus:outline-none sm:w-11/12 md:w-2/3 lg:w-1/2 mx-auto text-base md:text-lg sm:text-md text-justify text-gray-900 dark:text-white"
            contenteditable="true"
            set:html={con === null || con === ""?"<div></br></div>": contents[0].content}><div></br></div></div>
        <button id="print">PRINT</button>
        <button id="upload">UPLOAD</button>

        <div id="contextMenu" class="absolute hidden bg-slate-300 border-spacing-1 p-2">
            <div class="flex gap-2">
                <button id="bold" class="hover:bg-slate-50 p-1 rounded-sm text-xl font-bold">B</button>
                <button id="h2" class="hover:bg-slate-50 p-1 rounded-sm">h2</button>
                <button id="img" class="hover:bg-slate-50 p-1 rounded-sm">
                    <img src="/img.webp" loading="lazy" class="w-6"/>
                </button>
                <button id="link" class="hover:bg-slate-50 p-1 rounded-sm text-sm">https..</button>
            </div>
        </div>
        <input id="link-input" class="absolute hidden w-14 bg-slate-300"/>
        <div>
            <button id="download">LOAD</button>
            <div id="dataview"></div>
        </div>
    </body>
</html>

<script>
    let timeoutId
    var linked

    const desc = document.getElementById("description")
    desc.addEventListener("input", event => {
        autoSave()
    })

    async function autoSave() {
        clearTimeout(timeoutId)
        timeoutId = setTimeout(() => {
            saving.classList.remove("hidden")

            const childNodes = element.childNodes;
            // Iterasi melalui node anak secara terbalik untuk menghindari masalah saat menghapus node
            for (let i = childNodes.length - 1; i >= 0; i--) {
                const node = childNodes[i];
                // Periksa apakah node adalah node teks dan tidak hanya berisi spasi kosong
                if (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '') {
                // Hapus node teks
                    element.removeChild(node);
                }
            }
            //console.log("saving data..")
            const post = {
                data: element.innerHTML,
                id: document.getElementById("content_id").innerText,
                title: title.value,
                desc: desc.value,
                img_src: element.querySelector("img")?.src,
                category: cat.value
            }
            fetch("/api/content/content-v3", {
                method: "POST",
                headers : {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(post),
            })
            setTimeout(() => {
                saving.classList.add("hidden")
            }, 1500);
        }, 3000)
    }

    const saving = document.getElementById("saving")

    const element = document.getElementById("input")
    element.addEventListener("keydown", event => {
        if(element.childElementCount <= 1 && event.key === "Backspace"){
            if(element.firstChild.textContent.length === 0){
                event.preventDefault()
            }
        }
        autoSave()
    })
    element.addEventListener("paste", event => {
        event.preventDefault()
        const text = event.clipboardData.getData("text/plain")
        const newElement = document.createElement("p")
        newElement.innerHTML = text
        element.appendChild(newElement)
    })

    const title = document.getElementById("title")
    title.addEventListener("input", event => {
        title.style.height = "auto"
        title.style.height = `${title.scrollHeight}px`
        autoSave()
    })

    const print = document.getElementById("print")
    print.addEventListener("click", event => {
    })

    const menu = document.getElementById('contextMenu')

    element.addEventListener('mouseup', function(event) {
        const selectedText = window.getSelection().toString()

        if (selectedText.length > 0) {
            const range = window.getSelection().getRangeAt(0)
            const rect = range.getBoundingClientRect()
            //console.log(range)

            menu.style.top = `${rect.bottom + window.scrollY}px`
            menu.style.left = `${rect.left + window.scrollX}px`
            menu.classList.remove("hidden")
        } else {
            menu.classList.add("hidden")
        }
    });

    document.addEventListener('selectionchange', () => {
        const selectedElement = getSelectedElement();
        if (selectedElement) {
            //console.log('Teks dipilih dalam elemen:', selectedElement);
        }
    });

    const bold = document.getElementById("bold")
    bold.addEventListener("click", event => {
        const range = getSelectedElement()
        if(!(range.commonAncestorContainer.parentElement.tagName === "SPAN")){
            const b = document.createElement("span")
            b.style.fontWeight = "700"
            range.surroundContents(b)
        }else if(range.commonAncestorContainer.parentElement.tagName === "SPAN"){
            const span = range.commonAncestorContainer.parentElement
            const parent = range.commonAncestorContainer.parentElement.parentElement
            while (span.firstChild) {
                parent.insertBefore(span.firstChild, span);
            }
            parent.removeChild(span)
        }
        menu.style.display = 'none'
        autoSave()
    })

    const h2 = document.getElementById("h2")
    h2.addEventListener("click", event => {
        const elementSelected = getSelectedElement().commonAncestorContainer.parentElement
        if(elementSelected.tagName === "H2"){
            const addh2 = document.createElement("p")
            addh2.innerText = elementSelected.innerText
            elementSelected.parentNode.insertBefore(addh2, elementSelected)
            elementSelected.remove()
        }else{
            const addh2 = document.createElement("h2")
            addh2.classList.add("text-2xl", "font-semibold")
            addh2.innerText = elementSelected.innerText
            elementSelected.parentNode.insertBefore(addh2, elementSelected)
            elementSelected.remove()
        }
        menu.classList.add("hidden")
        autoSave()
    })

    const img = document.getElementById("img")
    img.addEventListener("click", event => {
        const selectedElement = getSelectedElement().commonAncestorContainer.parentElement
        const image = document.createElement("img")
        image.src = selectedElement.innerText
        image.classList.add("w-1/2", "mx-auto")
        selectedElement.parentElement.insertBefore(image, selectedElement)
        selectedElement.remove()
        autoSave()
    })

    const linkInput = document.getElementById("link-input")
    const link = document.getElementById("link")
    link.addEventListener("click", event => {
        const range = getSelectedElement()
        if(!(range.commonAncestorContainer.parentElement.tagName === "A")){
            const a = document.createElement("a")
            const loc = window.getSelection().getRangeAt(0)
            const rect = loc.getBoundingClientRect()

            linkInput.style.top = `${rect.bottom + window.scrollY - 45}px`
            linkInput.style.left = `${rect.left + window.scrollX}px`

            linkInput.classList.remove("hidden")
            linked = a
            a.classList.add("underline")
            a.href = "/beranda"
            range.surroundContents(a)
        }else if(range.commonAncestorContainer.parentElement.tagName === "A"){
            const a = range.commonAncestorContainer.parentElement
            const parent = range.commonAncestorContainer.parentElement.parentElement
            while (a.firstChild) {
                parent.insertBefore(a.firstChild, a);
            }
            parent.removeChild(a)
        }
        menu.classList.add("hidden")
        autoSave()
    })
    linkInput.addEventListener("keydown", event => {
        if(event.key === "Enter"){
            event.preventDefault()
            linked.href = linkInput.value
            linkInput.classList.add("hidden")
            autoSave()
        }
    })

    const cat = document.getElementById("category")
    cat.addEventListener("change", event => {
        autoSave()
    })

    const upload = document.getElementById("upload")
    upload.addEventListener("click", async event => {
        autoSave()
    })

    const download = document.getElementById("download")
    download.addEventListener("click", async (event) => {
        const dataElement = document.getElementById("dataview")
        const data = await fetch("/api/content/content-v3").then(res => {
            return res.json()
        })
        console.log(data)
        dataElement.innerHTML = data.data[0].content
    })

    function getSelectedElement() {
        const selection = document.getSelection();
        if (selection.rangeCount > 0) {
            const range = selection.getRangeAt(0);
            //console.log(range)
            return range
            // const commonAncestor = range.commonAncestorContainer;
            // return commonAncestor.nodeType === 1 ? commonAncestor : commonAncestor.parentElement;
        }
        return null;
    }
</script>