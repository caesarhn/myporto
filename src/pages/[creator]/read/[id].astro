---
import Header from "../../../components/MainHeader.astro"
import Footer from '../../../components/MainFooter.astro'
import {db} from '../../../utils/mysql/index'
import {content, contentComponent, creator} from '../../../models/mysql/schema'
import {eq} from 'drizzle-orm'

const {creatorname, id} = Astro.params
const content_root = await db.select().from(content).where(eq(content.id, id))
await db.update(content).set({
    view: content_root[0].view + 1
}).where(eq(content.id, id))
const sub_content = await db.select().from(contentComponent).where(eq(contentComponent.contentId, id)).orderBy(contentComponent.index)
const creatordesc = await db.select().from(creator).where(eq(creator.id, content_root[0].creatorId))
//console.log(sub_content)
const description = content_root[0].previewDesc
---

<!doctype html>
<html lang="id">
    <head>
        <link rel="icon" type="image/x-icon" href="/fav.ico">
        <meta charset="UTF-8" />
        <meta name="description" content={description}/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{content_root[0]?.tittle}</title>
        <link href='https://fonts.googleapis.com/css?family=Roboto' rel='stylesheet'>
    </head>
    <body class="min-h-full bg-slate-100">
        <script>
            import { Modal } from 'flowbite'
        </script>
        <Header/>
        <div class="flex sm:block md:hidden w-fit mx-auto mt-2">
        </div>
        <main class="sm:w-full sm:px-5 md:w-1/2 md:mx-auto lg:w-2/5 lg:mx-auto bg-slate-50 mt-20 pt-5">
            <p id="cat" class="mb-8">{content_root[0]?.category}</p>
            <div class="content-head">
                <h1 class="mb-4 font-extrabold leading-none tracking-tight text-gray-900 sm:text-3xl md:text-5xl lg:text-4xl dark:text-white">{content_root[0]?.tittle ?? "kosong"}</h1>
                <p class="sm:text-sm md:text-md"><span class="mx-1"><a href="/porto">{creatordesc[0]?.name}</a></span> | <span class="mx-1">{content_root[0]?.posted}</span> | <span></span></p>
            </div>
            <br/>
            <div id="raw-content" class="hidden">{content_root[0].content}</div>
            <div id="contents" class="text-base md:text-lg sm:text-md text-justify text-gray-900 dark:text-white"></div>
            <script>document.getElementById("contents").innerHTML = document.getElementById("raw-content").innerText</script>
            
