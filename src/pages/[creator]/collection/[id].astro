                    //     method: 'POST',
                    //     mode: 'cors',
                    //     headers: {
                    //         'Content-Type': 'application/json',
                    //     },
                    //     body: JSON.stringify(data),
                    // }).then(res => {
                    //     return res.json()
                    // }).then(data => {
                    //     console.log(data)
                    //     location.href = '/creator/write/'+data.Data
                    // })
                })
            </script>
        </div>
    </body>
</html>