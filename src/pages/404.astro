<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Not Found</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
    </head>
    <body class="relative w-screen min-h-screen bg-slate-600" style="">
        <img src="astronaut.svg" width="40" id="astronaut" class="absolute"/>
        <img src="astronaut.svg" width="40" id="astronaut1" class="absolute"/>
        <img src="astronaut.svg" width="40" id="astronaut2" class="absolute"/>
        <img src="astronaut.svg" width="40" id="astronaut3" class="absolute"/>
        <img src="astronaut.svg" width="40" id="astronaut4" class="absolute"/>
        <div class="sm:w-full md:w-3/4 lg:w-1/2 h-full mx-auto top-20">
            <img src="/earth.svg" width="300px" class="mx-auto"/>
            <div class="text-center w-fit mx-auto text-2xl font-bold text-slate-50">
                <p class="font-semibold text-lg">engineeringsampel.com</p>
                <h1>Not Found</h1>
                <h1>404</h1>
            </div>
        </div>
    </body>
</html>

<script>
    const windowWidth = window.innerWidth - 50
    const windowHeight = window.innerHeight - 50
    var rot = [0, 0, 0, 0, 0]
    var locx = [0, 0, 0, 0, 0]
    var locy = [0, 0, 0, 0, 0]
    var movx = [1, -1, -1, 1, -1]
    var movy = [-1, -1, 1, 1, 1]

    for(var i = 0; i < locx.length; i++){
        locx[i] = random(1, windowWidth)
        locy[i] = random(1, windowHeight)
    }

    console.log(windowWidth, windowHeight)
    const astronaut = document.getElementById("astronaut")
    const astronaut1 = document.getElementById("astronaut1")
    const astronaut2 = document.getElementById("astronaut2")
    const astronaut3 = document.getElementById("astronaut3")
    const astronaut4 = document.getElementById("astronaut4")
    
    astronaut.style.transform = `translate(${random(1, windowWidth)}px, ${random(1, windowHeight)}px`
    astronaut1.style.transform = `translate(${random(1, windowWidth)}px, ${random(1, windowHeight)}px`
    astronaut2.style.transform = `translate(${random(1, windowWidth)}px, ${random(1, windowHeight)}px`
    astronaut3.style.transform = `translate(${random(1, windowWidth)}px, ${random(1, windowHeight)}px`
    astronaut4.style.transform = `translate(${random(1, windowWidth)}px, ${random(1, windowHeight)}px`
    function animation(){
        //console.log(random(1, windowWidth))
        //rotation
        for(var i = 0; i < rot.length; i++){
            if(rot[i] == 360){
                rot[i] = 0
            }else{
                rot[i]++
            }
        }

        //moving
        for(var i = 0; i < locx.length; i++){
            locx[i] = locx[i] + movx[i]
            locy[i] = locy[i] + movy[i]
        }

        //check collision
        for(var i = 0; i < locx.length; i++){
            if(locx[i] < 1){
                movx[i] = 1
            }else if(locx[i] > windowWidth){
                movx[i] = -1
            }
            
            if(locy[i] < 1){
                movy[i] = 1
            }else if(locy[i] > windowHeight){
                movy[i] = -1
            }
        }

        astronaut.style.transform = `translate(${locx[0]}px, ${locy[0]}px) rotate(${rot[0]}deg)`
        astronaut1.style.transform = `translate(${locx[1]}px, ${locy[1]}px) rotate(${rot[1]}deg)`
        astronaut2.style.transform = `translate(${locx[2]}px, ${locy[2]}px) rotate(${rot[2]}deg)`
        astronaut3.style.transform = `translate(${locx[3]}px, ${locy[3]}px) rotate(${rot[3]}deg)`
        astronaut4.style.transform = `translate(${locx[4]}px, ${locy[4]}px) rotate(${rot[4]}deg)`
        requestAnimationFrame(animation)
    }

    function random(min, max){
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    animation()
</script>