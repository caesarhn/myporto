---
import Layout from '../layouts/Layout.astro'
import Card from '../components/Card.astro'
import Banner from '../components/banner/BannerGrid.astro'
import Footer from '../components/MainFooter.astro'
export const prerender = false

const webTemplate = [{
	img: "https://th.bing.com/th/id/OIP.h_Ggv2dSVFkTQIvvZpjuLwAAAA?rs=1&pid=ImgDetMain",
	link: "dfasdass"
},{
	img: "https://miro.medium.com/v2/resize:fit:3200/1*SNUFXbMYSOArQbA-Iwi-jA.png",
	link: "safad"
},{
	img: "https://miro.medium.com/v2/resize:fit:3200/1*SNUFXbMYSOArQbA-Iwi-jA.png",
	link: "safad"
},{
	img: "https://miro.medium.com/v2/resize:fit:3200/1*SNUFXbMYSOArQbA-Iwi-jA.png",
	link: "safad"
}]

---

<Layout title="Engineering Sample.">
	<div class="w-full">
		<Banner>
			<div class="">
				<h1 class="relative w-full text-center text-amber-50 sm:text-7xl md:text-5xl lg:text-6xl font-extrabold ">Build Your World With Technology</h1>
				<h2 class="relative w-full text-center text-amber-50 sm:text-4xl md:text-2xl lg:text-3xl font-bold mt-24">join us, <mark class="text-white rounded-lg px-4 bg-purple-900">write</mark> and share your knowledge</h2>
				<div class="flex w-full justify-center">
					<button type="button" onclick="window.location.href='/beranda'" class="max-h-60 mt-10 sm:top-24 md:top-72 text-black bg-white hover:bg-purple-300 font-medium rounded-lg sm:tex-3xl md:text-sm px-5 py-3 dark:bg-white dark:hover:bg-purple-200">Get Started</button>
				</div>
			</div>
		</Banner>
	</div>

	<br/>
	<main class="w-full">
		<div id="welcome-content" class="mx-auto sm:w-11/12 md:w-8/12 lg:w-1/2 xl:w-1/2">
			<h1 class="sm:text-8xl md:text-xl lg:text-5xl my-20 font-bold text-slate-200">Welcome to <span class="text-gradient">Engineering Sample</span></h1>
			<p class="instructions text-amber-50 sm:text-4xl md:text-xl">
				Engineering Sample is a <span class="font-bold">content-based</span> website built with the purpose of sharing knowledge about technology. You can join as a writer to share your knowledge or as a reader to explore and gain knowledge.
			</p>
			<ul role="list" class="grid sm:grid-cols-1 lg:grid-cols-2 gap-4">
				<Card
					href="https://github.com/caesar6747/myporto"
					title="Documentation"
					body="This website is under construction. check the github"
				/>
				<Card
					href="https://astro.build/integrations/"
					title="Integrations"
					body="Supercharge your project with new frameworks and libraries."
				/>
				<Card
					href="https://astro.build/themes/"
					title="Themes"
					body="Explore a galaxy of community-built starter themes."
				/>
				<Card
					href="https://astro.build/chat/"
					title="Community"
					body="Come say hi to our amazing Discord community. ❤️"
				/>
			</ul>
		</div>
		<hr class="my-36 border-slate-800"/>
		<div id="content2" class="mx-auto sm:w-11/12 md:w-8/12 lg:w-1/2 xl:w-1/2">
			<h1 class="sm:text-8xl md:text-5xl font-bold text-amber-50">Build portofolio for free</h1>
			<p class="sm:text-4xl md:text-xl mt-10 text-lg font-semibold text-slate-200">Build your portofolio website for free, choose your template you like</p>
		</div>
		<div id="content2sub" class="w-full overflow-x-hidden mt-20">
			<div id="scroll-object1" class="flex gap-10 max-w-max">
				{
					webTemplate.map( (item) => {
						return <div class="min-h-80 scroll-box">
							<img src={item.img} class="object-cover h-80 min-w-128" loading="lazy"/>
						</div>
					})
				}
			</div>
			<br/>
			<div id="scroll-object2" class="flex gap-10 max-w-max">
				{
					webTemplate.map( (item) => {
						return <div class="h-60 gap-10 scroll-box2">
							<img src={item.img} class="max-h-60 min-w-96" loading="lazy"/>
						</div>
					})
				}
			</div>
		</div>
	</main>
	<div>
		<script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8502078264600273"
		crossorigin="anonymous"></script>
		<ins class="adsbygoogle"
			style="display:block; text-align:center;"
			data-ad-layout="in-article"
			data-ad-format="fluid"
			data-ad-client="ca-pub-8502078264600273"
			data-ad-slot="9794377389"></ins>
		<script is:inline>
			(adsbygoogle = window.adsbygoogle || []).push({});
		</script>
	</div>
	<Footer/>
</Layout>

<style>
	@import "../components/tailwind.css";
	.astro-a {
		position: absolute;
		top: -32px;
		left: 50%;
		transform: translatex(-50%);
		width: 220px;
		height: auto;
		z-index: -1;
	}
	.text-gradient {
		background-image: var(--accent-gradient);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-size: 400%;
		background-position: 0%;
	}
	.instructions {
		margin-bottom: 2rem;
		border: 1px solid rgba(var(--accent-light), 25%);
		background: linear-gradient(rgba(var(--accent-dark), 66%), rgba(var(--accent-dark), 33%));
		padding: 1.5rem;
		border-radius: 8px;
	}
	.instructions code {
		font-size: 0.8em;
		font-weight: bold;
		background: rgba(var(--accent-light), 12%);
		color: rgb(var(--accent-light));
		border-radius: 4px;
		padding: 0.3em 0.4em;
	}
	.instructions strong {
		color: rgb(var(--accent-light));
	}
	.link-card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
		gap: 2rem;
		padding: 0;
	}
	#welcome-content{
		opacity: 0%;
	}

	#content2{
		opacity: 0%;
	}

	#content2sub{
		opacity: 0%;
	}

	#scroll-object1{
		animation: scrolling-horizontal 30s linear infinite;
	}

	#scroll-object2{
		animation: scrolling-horizontal2 20s linear infinite;
	}

	@keyframes appear{
		0%{
			position: relative;
			left: 100px;
			opacity: 0%;
		}
		100%{
			position: relative;
			left: 0px;
			opacity: 100%;
		}
	}

	@keyframes scrolling-horizontal {
		0%{
			transform: translateX(0%);
		}
		100%{
			transform: translateX(-154rem)
		}
	}

	@keyframes scrolling-horizontal2 {
		0%{
			transform: translateX(-106rem);
		}
		100%{
			transform: translateX(0%)
		}
	}
</style>

<script is:inline>
	const scrollContent = document.getElementById("scroll-object1")
	const scrollBoxs = Array.from(document.getElementsByClassName("scroll-box"))
	const scrollContent2 = document.getElementById("scroll-object2")
	const scrollBoxs2 = Array.from(document.getElementsByClassName("scroll-box2"))

	scrollBoxs.forEach(box => {
		const clone = box.cloneNode(true)
		scrollContent.appendChild(clone)
	})
	scrollBoxs2.forEach(box => {
		const clone = box.cloneNode(true)
		scrollContent2.appendChild(clone)
	})

	let scrolled = 0

	window.addEventListener("scroll", function(event) {
		if(this.scrollY > scrolled){
			scrolled = this.scrollY

			if(this.scrollY > 300){
				const a = this.document.getElementById('welcome-content')
				a.style.animationName = "appear"
				a.style.animationDuration = "2s"
				a.style.opacity = "100%"
			}
			if(this.scrollY > 800){
				const a = this.document.getElementById('content2')
				const b = this.document.getElementById('content2sub')
				a.style.animationName = "appear"
				a.style.animationDuration = "2s"
				a.style.opacity = "100%"
				b.style.animationName = "appear"
				b.style.animationDuration = "2s"
				b.style.opacity = "100%"
			}
		}
	}, false);
</script>
