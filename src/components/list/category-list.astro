---
const {categorys, categoryRequested} = Astro.props
---

<div>
    <ul class="flex gap-8 text-no-hightlight sm:text-md md:text-sm lg:text-sm overflow-x-scroll no-scrollbar">
        {categorys.map(res => {
            if(categoryRequested == res){
                return <li class="hover:bg-gray-100 px-1 pb-1 rounded-sm border-b-2 border-b-black text-black">
                    <button>{res}</button>
                </li>
            }else{
                var link = "/" + res
                if(res === "All"){
                    link = ""
                }
                return <li class="hover:bg-gray-100 px-1 pb-1 rounded-sm" onclick={"window.location.href='/beranda"+link+"'"}>
                    <button>{res}</button>
                </li>
            }
        })}
    </ul>
    <hr class="sm:w-full md:w-11/12 lg:w-3/4 h-px mb-8 bg-gray-200 border-0 dark:bg-gray-700"/>
</div>