<div class="relative w-72 mx-auto top-52">
    <h1 class="text-4xl text-slate-700 font-extrabold">Log in</h1>
    <form class="form" method="post" action="/login">
        <input class="w-full border-x-0 border-t-0 border-b-2 border-gray-600 mt-5" name="username" type="text" placeholder="username"/>
        <input class="w-full border-x-0 border-t-0 border-b-2 border-gray-600 mt-5" name="password" type="password" placeholder="password"/>
        <button class="bg-slate-600 hover:bg-slate-400 text-slate-50 mt-10 px-5 py-1 rounded-sm" type="submit">login</button>
    </form>
</div>